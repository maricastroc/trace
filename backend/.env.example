APP_NAME=Trace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=trace
DB_USERNAME=trace
DB_PASSWORD=trace

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

FRONTEND_URL=http://localhost:3000,http://localhost:3001

TRACE_MODE=local
TRACE_UPLOADS_ENABLED=true
TRACE_MAX_UPLOAD_KB=10240
TRACE_MAX_ROWS=50000
TRACE_MAX_COLUMNS=100
TRACE_MAX_TUPLES=500000
TRACE_WORKSPACE_TTL_DAYS=30
